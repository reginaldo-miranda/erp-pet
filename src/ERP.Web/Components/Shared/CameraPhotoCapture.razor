@using Microsoft.AspNetCore.Components.Forms
@inject IWebHostEnvironment Env
@inject ISnackbar Snackbar

<div class="d-flex flex-column gap-2">
    <div class="d-flex align-center gap-2 flex-wrap">
        <label class="mud-button-root mud-button mud-button-outlined mud-button-outlined-primary mud-button-size-small mud-ripple"
               style="cursor:pointer;">
            <span class="mud-button-label d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.PhotoCamera" Size="Size.Small" />
                @_rotuloBotao
            </span>
            <InputFile OnChange="OnFileSelected" accept="image/*" capture="environment" style="display:none;" />
        </label>

        @if (!string.IsNullOrWhiteSpace(ImageUrl))
        {
            <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                           OnClick="RemoverFoto" />
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <MudImage Src="@ImageUrl" Alt="Foto capturada" Width="120" Height="120" ObjectFit="ObjectFit.Cover"
                  Class="rounded elevation-1" />
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "Tirar Foto / Galeria";
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public EventCallback<string?> ImageUrlChanged { get; set; }

    private string _rotuloBotao => string.IsNullOrWhiteSpace(ImageUrl) ? Label : "Trocar Foto";

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            var resized = await file.RequestImageFileAsync("image/jpeg", 1280, 1280);
            var folder = Path.Combine(Env.WebRootPath, "uploads", "pet");
            Directory.CreateDirectory(folder);

            var fileName = $"{Guid.NewGuid():N}.jpg";
            var fullPath = Path.Combine(folder, fileName);

            await using var stream = resized.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            await using var fs = File.Create(fullPath);
            await stream.CopyToAsync(fs);

            var url = $"/uploads/pet/{fileName}";
            ImageUrl = url;
            await ImageUrlChanged.InvokeAsync(url);
            Snackbar.Add("Foto capturada e salva!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Erro ao salvar foto: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoverFoto()
    {
        ImageUrl = null;
        await ImageUrlChanged.InvokeAsync(null);
    }
}
