@page "/pet/vet/internacao"
@using ERP.Application.Common.Interfaces
@using ERP.Application.Pet.Ambulatorio
@using ERP.Application.Pet.Comandas
@using ERP.Application.Pet.Internacao
@using ERP.Application.Pet.Pets
@using ERP.Domain.Core.Enums
@using MediatR
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject IApplicationDbContext DbContext
@inject ISnackbar Snackbar

<PageTitle>Internação 24h &amp; Mapa de Baias</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
    <MudText Typo="Typo.h5" Class="mb-2">Internação 24h, Baias &amp; Enfermagem</MudText>

    <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-3">
        <MudTabPanel Text="Mapa de Baias & Admissão">
            <MudGrid Class="mb-4">
                @foreach (var baia in _baias)
                {
                    <MudItem xs="6" sm="4" md="3" lg="2">
                        <MudCard Outlined="true">
                            <MudCardContent Class="pa-3">
                                <MudText Typo="Typo.h6">@baia.Codigo</MudText>
                                <MudText Typo="Typo.caption">@baia.Setor</MudText><br />
                                <MudChip T="string" Size="Size.Small" Color="@(baia.Status == StatusBaiaInternacao.Livre ? Color.Success : Color.Error)">
                                    @baia.Status
                                </MudChip>
                                <MudText Typo="Typo.caption">@baia.ValorDiaria.ToString("C2")/dia</MudText>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>

            <MudPaper Class="pa-4 mb-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Admitir Paciente na Internação</MudText>
                <MudGrid AlignItems="Center">
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" Value="_petId" Label="Pet *" Variant="Variant.Outlined" Margin="Margin.Dense" ValueChanged="OnPetChanged">
                            @foreach (var p in _pets) { <MudSelectItem Value="p.Id">@p.Nome</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="3">
                        <MudSelect T="int" @bind-Value="_vetId" Label="Veterinário *" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var v in _vets) { <MudSelectItem Value="v.Id">@v.Nome</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="int" @bind-Value="_baiaId" Label="Baia Livre *" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var b in _baias.Where(x => x.Status == StatusBaiaInternacao.Livre)) { <MudSelectItem Value="b.Id">@b.Codigo (@b.Setor)</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudSelect T="int?" @bind-Value="_comandaId" Label="Comanda" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                            @foreach (var c in _comandasAbertas) { <MudSelectItem T="int?" Value="c.Id">@c.Numero</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="2">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Admitir">Internar</MudButton>
                    </MudItem>
                    <MudItem xs="12">
                        <MudTextField @bind-Value="_motivo" Label="Motivo / Diagnóstico da Internação *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <MudPaper Class="pa-4" Outlined="true">
                <MudText Typo="Typo.h6" Class="mb-3">Cadastrar Baia / Leito</MudText>
                <MudGrid AlignItems="Center">
                    <MudItem xs="6" md="2"><MudTextField @bind-Value="_novaBaiaCod" Label="Código (ex: UTI-01)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" md="3"><MudTextField @bind-Value="_novaBaiaNome" Label="Descrição" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="6" md="3">
                        <MudSelect T="SetorInternacao" @bind-Value="_novaBaiaSetor" Label="Setor" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var s in Enum.GetValues<SetorInternacao>()) { <MudSelectItem Value="s">@s</MudSelectItem> }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="6" md="2"><MudNumericField T="decimal" @bind-Value="_novaBaiaDiaria" Label="Diária (R$)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                    <MudItem xs="12" md="2"><MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CriarBaia">Criar Baia</MudButton></MudItem>
                </MudGrid>
            </MudPaper>
        </MudTabPanel>

        <MudTabPanel Text="Enfermagem, Aprazamento & Evolução">
            @foreach (var inter in _internacoes.Where(i => i.Status == StatusInternacaoPet.Ativa))
            {
                <MudPaper Class="pa-4 mb-4" Elevation="2">
                    <div class="d-flex justify-space-between align-center mb-2">
                        <div>
                            <MudText Typo="Typo.h6">@inter.Numero — @inter.NomePet (Baia @inter.CodigoBaia / @inter.SetorBaia)</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Tutor: @inter.NomeTutor | Vet: @inter.NomeVeterinario | Motivo: @inter.MotivoInternacao</MudText>
                        </div>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success" OnClick="() => DarAlta(inter.Id)">
                            Dar Alta Médica
                        </MudButton>
                    </div>

                    <div class="d-flex gap-2 mb-3">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   OnClick="() => AbrirPrescricao(inter.Id)">
                            + Nova Prescrição
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary"
                                   OnClick="() => AbrirEvolucao(inter.Id)">
                            + Registrar Evolução
                        </MudButton>
                    </div>

                    @if (_prescricaoInternacaoId == inter.Id)
                    {
                        <MudPaper Class="pa-3 mb-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Nova Prescrição Aprazada</MudText>
                            <MudGrid AlignItems="Center">
                                <MudItem xs="12" md="3">
                                    <MudSelect T="int?" @bind-Value="_prescProdutoId" Label="Produto Estoque (Opcional)" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                                        @foreach (var p in _produtos) { <MudSelectItem T="int?" Value="p.Id">@p.Nome</MudSelectItem> }
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="12" md="3"><MudTextField @bind-Value="_prescMed" Label="Medicação *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="2"><MudTextField @bind-Value="_prescDose" Label="Dose *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="1"><MudNumericField T="int" @bind-Value="_prescIntervalo" Label="h/h" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="1"><MudNumericField T="int" @bind-Value="_prescDoses" Label="Doses" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="6" md="2"><MudNumericField T="decimal" @bind-Value="_prescValor" Label="Valor/Dose" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="12" Class="d-flex justify-end gap-2">
                                    <MudButton Size="Size.Small" OnClick="() => _prescricaoInternacaoId = null">Cancelar</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SalvarPrescricao">Salvar Prescrição</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }

                    @if (_evolucaoInternacaoId == inter.Id)
                    {
                        <MudPaper Class="pa-3 mb-3" Outlined="true">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Registrar Evolução de Plantão</MudText>
                            <MudGrid AlignItems="Center">
                                <MudItem xs="6" md="2">
                                    <MudSelect T="string" @bind-Value="_evolTurno" Label="Turno" Variant="Variant.Outlined" Margin="Margin.Dense">
                                        <MudSelectItem Value="@("Manhã")">Manhã</MudSelectItem>
                                        <MudSelectItem Value="@("Tarde")">Tarde</MudSelectItem>
                                        <MudSelectItem Value="@("Noite")">Noite</MudSelectItem>
                                        <MudSelectItem Value="@("Madrugada")">Madrugada</MudSelectItem>
                                    </MudSelect>
                                </MudItem>
                                <MudItem xs="6" md="3"><MudTextField @bind-Value="_evolProfissional" Label="Profissional *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="4" md="2"><MudNumericField T="decimal?" @bind-Value="_evolTemp" Label="Temp (°C)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="4" md="2"><MudNumericField T="int?" @bind-Value="_evolFc" Label="FC (bpm)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                                <MudItem xs="4" md="3"><MudCheckBox @bind-Value="_evolVisivelTutor" Label="Enviar Boletim Tutor" /></MudItem>
                                <MudItem xs="12"><MudTextField @bind-Value="_evolDesc" Label="Descrição da Evolução *" Lines="2" Variant="Variant.Outlined" /></MudItem>
                                <MudItem xs="12" Class="d-flex justify-end gap-2">
                                    <MudButton Size="Size.Small" OnClick="() => _evolucaoInternacaoId = null">Cancelar</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Secondary" OnClick="SalvarEvolucao">Salvar Evolução</MudButton>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }

                    <MudText Typo="Typo.subtitle2" Class="mt-3 mb-1">Grade Horária de Enfermagem</MudText>
                    <MudTable Items="inter.ChecagensPendentes" Dense="true" Hover="true">
                        <HeaderContent><MudTh>Previsto</MudTh><MudTh>Medicação</MudTh><MudTh>Dose</MudTh><MudTh>Status</MudTh><MudTh>Ação</MudTh></HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.DataHoraPrevista.ToLocalTime().ToString("dd/MM HH:mm")</MudTd>
                            <MudTd>@context.DescricaoMedicamento</MudTd>
                            <MudTd>@context.Dose</MudTd>
                            <MudTd><MudChip T="string" Size="Size.Small" Color="@(context.Status == StatusChecagemEnfermagem.Aplicado ? Color.Success : Color.Warning)">@context.Status</MudChip></MudTd>
                            <MudTd>
                                @if (context.Status == StatusChecagemEnfermagem.Pendente)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="() => ChecarDose(context.Id)">
                                        Marcar Aplicado
                                    </MudButton>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                </MudPaper>
            }
        </MudTabPanel>
    </MudTabs>
</MudContainer>

@code {
    private List<BaiaInternacaoDto> _baias = new();
    private List<InternacaoDto> _internacoes = new();
    private List<PetDto> _pets = new();
    private List<VeterinarioDto> _vets = new();
    private List<ComandaAtendimentoDto> _comandasAbertas = new();
    private int? _depositoPadraoId;
    private List<ERP.Domain.Core.Entities.Cadastros.Produto> _produtos = new();

    private int? _prescricaoInternacaoId;
    private int? _prescProdutoId;
    private string _prescMed = string.Empty;
    private string _prescDose = string.Empty;
    private int _prescIntervalo = 8;
    private int _prescDoses = 3;
    private decimal _prescValor;

    private int? _evolucaoInternacaoId;
    private string _evolTurno = "Manhã";
    private string _evolProfissional = "Plantonista";
    private decimal? _evolTemp;
    private int? _evolFc;
    private string _evolDesc = string.Empty;
    private bool _evolVisivelTutor = true;

    private int _petId;
    private int _clienteId;
    private int _vetId;
    private int _baiaId;
    private int? _comandaId;
    private string _motivo = string.Empty;

    private string _novaBaiaCod = string.Empty;
    private string _novaBaiaNome = string.Empty;
    private SetorInternacao _novaBaiaSetor = SetorInternacao.Canil;
    private decimal _novaBaiaDiaria = 180m;

    protected override async Task OnInitializedAsync()
    {
        var dep = await DbContext.Depositos.AsNoTracking().FirstOrDefaultAsync();
        _depositoPadraoId = dep?.Id;
        _produtos = await DbContext.Produtos.AsNoTracking().OrderBy(p => p.Nome).Take(200).ToListAsync();

        var pRes = await Mediator.Send(new GetPetsQuery());
        if (pRes.Sucesso && pRes.Dados != null) { _pets = pRes.Dados; if (_pets.Count > 0) OnPetChanged(_pets[0].Id); }

        var vRes = await Mediator.Send(new GetVeterinariosQuery());
        if (vRes.Sucesso && vRes.Dados != null) { _vets = vRes.Dados; if (_vets.Count > 0) _vetId = _vets[0].Id; }

        var cRes = await Mediator.Send(new GetComandasQuery(StatusComanda.Aberta));
        if (cRes.Sucesso && cRes.Dados != null) _comandasAbertas = cRes.Dados;

        await CarregarTudo();
    }

    private void OnPetChanged(int petId)
    {
        _petId = petId;
        _clienteId = _pets.FirstOrDefault(p => p.Id == petId)?.Tutores.FirstOrDefault()?.ClienteId ?? 0;
    }

    private async Task CarregarTudo()
    {
        var b = await Mediator.Send(new GetBaiasInternacaoQuery());
        if (b.Sucesso && b.Dados != null)
        {
            _baias = b.Dados;
            var livre = _baias.FirstOrDefault(x => x.Status == StatusBaiaInternacao.Livre);
            if (livre != null) _baiaId = livre.Id;
        }
        var i = await Mediator.Send(new GetInternacoesAtivasQuery());
        if (i.Sucesso && i.Dados != null) _internacoes = i.Dados;
    }

    private async Task CriarBaia()
    {
        var res = await Mediator.Send(new CreateBaiaInternacaoCommand(_novaBaiaCod, _novaBaiaNome, _novaBaiaSetor, _novaBaiaDiaria));
        if (res.Sucesso) { Snackbar.Add("Baia criada!", Severity.Success); _novaBaiaCod = ""; _novaBaiaNome = ""; await CarregarTudo(); }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private async Task Admitir()
    {
        if (_petId <= 0 || _vetId <= 0 || _baiaId <= 0 || string.IsNullOrWhiteSpace(_motivo))
        {
            Snackbar.Add("Preencha Pet, Veterinário, Baia Livre e Motivo.", Severity.Warning);
            return;
        }
        var res = await Mediator.Send(new AdmitirInternacaoCommand(_petId, _clienteId, _vetId, _baiaId, _comandaId, _motivo));
        if (res.Sucesso) { Snackbar.Add("Paciente internado!", Severity.Success); _motivo = ""; await CarregarTudo(); }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private async Task ChecarDose(int checagemId)
    {
        var res = await Mediator.Send(new ChecarEnfermagemCommand(checagemId, "Enfermagem Plantão", _depositoPadraoId, null));
        if (res.Sucesso) { Snackbar.Add("Medicação checada (estoque e comanda atualizados)!", Severity.Success); await CarregarTudo(); }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private async Task DarAlta(int internacaoId)
    {
        var res = await Mediator.Send(new DarAltaInternacaoCommand(internacaoId, StatusInternacaoPet.AltaMedica));
        if (res.Sucesso) { Snackbar.Add("Alta médica registrada e diárias lançadas!", Severity.Success); await CarregarTudo(); }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private void AbrirPrescricao(int internacaoId)
    {
        _prescricaoInternacaoId = internacaoId;
        _evolucaoInternacaoId = null;
    }

    private async Task SalvarPrescricao()
    {
        if (_prescricaoInternacaoId == null || string.IsNullOrWhiteSpace(_prescMed) || string.IsNullOrWhiteSpace(_prescDose))
        {
            Snackbar.Add("Informe medicação e dose.", Severity.Warning);
            return;
        }
        var res = await Mediator.Send(new PrescreverInternacaoCommand(
            _prescricaoInternacaoId.Value, _prescProdutoId, _prescMed, _prescDose, "IV/VO", 1m, _prescIntervalo, _prescDoses, _prescValor));
        if (res.Sucesso)
        {
            Snackbar.Add("Prescrição aprazada criada!", Severity.Success);
            _prescMed = ""; _prescDose = ""; _prescricaoInternacaoId = null;
            await CarregarTudo();
        }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private void AbrirEvolucao(int internacaoId)
    {
        _evolucaoInternacaoId = internacaoId;
        _prescricaoInternacaoId = null;
    }

    private async Task SalvarEvolucao()
    {
        if (_evolucaoInternacaoId == null || string.IsNullOrWhiteSpace(_evolDesc))
        {
            Snackbar.Add("Informe a descrição da evolução.", Severity.Warning);
            return;
        }
        var res = await Mediator.Send(new RegistrarEvolucaoInternacaoCommand(
            _evolucaoInternacaoId.Value, _evolTurno, _evolProfissional, _evolTemp, _evolFc, null, _evolDesc, _evolVisivelTutor));
        if (res.Sucesso)
        {
            Snackbar.Add("Evolução registrada!", Severity.Success);
            _evolDesc = ""; _evolucaoInternacaoId = null;
            await CarregarTudo();
        }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }
}
