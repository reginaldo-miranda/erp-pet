@page "/pet/pets"
@using ERP.Application.Common.Interfaces
@using ERP.Application.Pet.Convenios
@using ERP.Application.Pet.Pets
@using ERP.Domain.Core.Enums
@using MediatR
@using Microsoft.EntityFrameworkCore
@inject IMediator Mediator
@inject IApplicationDbContext DbContext
@inject ISnackbar Snackbar

<PageTitle>Pets &amp; Tutores - ERP Pet</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-0">
    <div class="d-flex justify-space-between align-center mb-2">
        <MudText Typo="Typo.h5">Pets &amp; Tutores (N:N)</MudText>
        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                   OnClick="() => _exibirFormulario = !_exibirFormulario">
            @(_exibirFormulario ? "Fechar Formulário" : "Novo Pet")
        </MudButton>
    </div>

    @if (_exibirFormulario)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="2">
            <MudText Typo="Typo.h6" Class="mb-3">Cadastrar Novo Pet</MudText>
            <MudGrid>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_nome" Label="Nome do Pet *" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="EspeciePet" @bind-Value="_especie" Label="Espécie" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var e in Enum.GetValues<EspeciePet>())
                        {
                            <MudSelectItem Value="e">@e</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudTextField @bind-Value="_raca" Label="Raça" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudSelect T="PortePet" @bind-Value="_porte" Label="Porte" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in Enum.GetValues<PortePet>())
                        {
                            <MudSelectItem Value="p">@p</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="TipoPelagemPet" @bind-Value="_pelagem" Label="Pelagem" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in Enum.GetValues<TipoPelagemPet>())
                        {
                            <MudSelectItem Value="p">@p</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="3">
                    <MudSelect T="TemperamentoPet" @bind-Value="_temperamento" Label="Temperamento" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var t in Enum.GetValues<TemperamentoPet>())
                        {
                            <MudSelectItem Value="t">@t</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="2">
                    <MudNumericField T="decimal?" @bind-Value="_pesoKg" Label="Peso (kg)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="_tutorPrincipalId" Label="Tutor Principal *" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var cli in _clientes)
                        {
                            <MudSelectItem Value="cli.Id">@cli.Nome (@cli.CpfCnpj)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_microchip" Label="Microchip" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="int?" @bind-Value="_convenioId" Label="Convênio Pet" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true">
                        @foreach (var conv in _convenios)
                        {
                            <MudSelectItem T="int?" Value="conv.Id">@conv.Nome (@conv.PercentualCoberturaPadrao%)</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="SexoPet" @bind-Value="_sexo" Label="Sexo" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var s in Enum.GetValues<SexoPet>()) { <MudSelectItem Value="s">@s</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2" Class="d-flex align-center">
                    <MudCheckBox @bind-Value="_castrado" Label="Castrado" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudDatePicker @bind-Date="_dataNascimento" Label="Nascimento" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudTextField @bind-Value="_corPelagem" Label="Cor Pelagem" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" md="4">
                    <MudTextField @bind-Value="_alergias" Label="Alergias / Restrições" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" Class="d-flex justify-end">
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SalvarPet">Salvar Pet</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    <MudPaper Class="pa-4 mb-4" Elevation="1">
        <MudGrid AlignItems="Center">
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_busca" Label="Buscar por Pet, Tutor, Raça ou Microchip"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true" />
            </MudItem>
            <MudItem xs="12" md="2">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CarregarPets">Filtrar</MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_petEditando != null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="3">
            <MudText Typo="Typo.h6" Class="mb-3">Editar Pet: @_petEditando.Nome</MudText>
            <MudGrid>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_editNome" Label="Nome *" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="3"><MudTextField @bind-Value="_editRaca" Label="Raça" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6" md="2"><MudNumericField T="decimal?" @bind-Value="_editPesoKg" Label="Peso (kg)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="PortePet" @bind-Value="_editPorte" Label="Porte" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var p in Enum.GetValues<PortePet>()) { <MudSelectItem Value="p">@p</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2">
                    <MudSelect T="SexoPet" @bind-Value="_editSexo" Label="Sexo" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var s in Enum.GetValues<SexoPet>()) { <MudSelectItem Value="s">@s</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="2" Class="d-flex align-center"><MudCheckBox @bind-Value="_editCastrado" Label="Castrado" /></MudItem>
                <MudItem xs="6" md="2"><MudDatePicker @bind-Date="_editDataNasc" Label="Nascimento" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="6" md="2"><MudTextField @bind-Value="_editCorPelagem" Label="Cor Pelagem" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="4">
                    <MudSelect T="TemperamentoPet" @bind-Value="_editTemp" Label="Temperamento" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var t in Enum.GetValues<TemperamentoPet>()) { <MudSelectItem Value="t">@t</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5"><MudTextField @bind-Value="_editAlergias" Label="Alergias / Restrições" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="3" Class="d-flex align-center"><MudCheckBox @bind-Value="_editObito" Label="Registrar Óbito" Color="Color.Dark" /></MudItem>
                <MudItem xs="12" Class="d-flex justify-end gap-2">
                    <MudButton Variant="Variant.Text" OnClick="() => _petEditando = null">Cancelar</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="SalvarEdicaoPet">Salvar Alterações</MudButton>
                </MudItem>
            </MudGrid>
        </MudPaper>
    }

    @if (_petTutoresAlvo != null)
    {
        <MudPaper Class="pa-4 mb-4" Elevation="3">
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.h6">Tutores Vinculados (N:N) — @_petTutoresAlvo.Nome</MudText>
                <MudButton Size="Size.Small" OnClick="() => _petTutoresAlvo = null">Fechar</MudButton>
            </div>
            <MudGrid AlignItems="Center" Class="mb-3">
                <MudItem xs="12" md="4">
                    <MudSelect T="int" @bind-Value="_novoTutorClienteId" Label="Tutor (Cliente)" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var cli in _clientes) { <MudSelectItem Value="cli.Id">@cli.Nome</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3">
                    <MudSelect T="TipoVinculoTutor" @bind-Value="_novoTutorVinculo" Label="Vínculo" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var v in Enum.GetValues<TipoVinculoTutor>()) { <MudSelectItem Value="v">@v</MudSelectItem> }
                    </MudSelect>
                </MudItem>
                <MudItem xs="6" md="3"><MudCheckBox @bind-Value="_novoTutorPodeAssinar" Label="Pode Assinar Termos" /></MudItem>
                <MudItem xs="12" md="2"><MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="VincularTutor">Vincular</MudButton></MudItem>
            </MudGrid>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var t in _petTutoresAlvo.Tutores)
                {
                    <MudChip T="string" Color="@(t.TipoVinculo == TipoVinculoTutor.Principal ? Color.Primary : Color.Default)"
                             OnClose="() => RemoverVinculoTutor(t.Id)">
                        @t.NomeTutor (@t.TipoVinculo)
                    </MudChip>
                }
            </div>
        </MudPaper>
    }

    <MudTable Items="_pets" Dense="true" Hover="true" Striped="true" Loading="_carregando" Elevation="2">
        <HeaderContent>
            <MudTh>Pet</MudTh>
            <MudTh>Espécie / Raça</MudTh>
            <MudTh>Sexo / Castrado</MudTh>
            <MudTh>Porte / Pelagem</MudTh>
            <MudTh>Peso</MudTh>
            <MudTh>Tutores Vinculados</MudTh>
            <MudTh>Convênio</MudTh>
            <MudTh>Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                <strong>@context.Nome</strong>
                @if (context.Temperamento == TemperamentoPet.Reativo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Reativo</MudChip>
                }
                @if (!string.IsNullOrWhiteSpace(context.Alergias))
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Error">Alergia</MudChip>
                }
                @if (context.Obito)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Dark">Óbito</MudChip>
                }
            </MudTd>
            <MudTd>@context.Especie — @(context.Raca ?? "SRD")</MudTd>
            <MudTd>@context.Sexo @(context.Castrado ? "(Castrado)" : "")</MudTd>
            <MudTd>@context.Porte / @context.TipoPelagem</MudTd>
            <MudTd>@(context.PesoAtualKg?.ToString("N2") ?? "-") kg</MudTd>
            <MudTd>
                @foreach (var t in context.Tutores)
                {
                    <MudChip T="string" Size="Size.Small" Color="@(t.TipoVinculo == TipoVinculoTutor.Principal ? Color.Primary : Color.Default)">
                        @t.NomeTutor (@t.TipoVinculo)
                    </MudChip>
                }
            </MudTd>
            <MudTd>@(context.NomeConvenio ?? "-")</MudTd>
            <MudTd>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" Class="mr-1" OnClick="() => AbrirEdicaoPet(context)">Editar</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Secondary" OnClick="() => AbrirTutoresPet(context)">Tutores</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudContainer>

@code {
    private bool _carregando = true;
    private bool _exibirFormulario;
    private string? _busca;
    private List<PetDto> _pets = new();
    private List<ERP.Domain.Core.Entities.Cadastros.Cliente> _clientes = new();
    private List<ConvenioPetDto> _convenios = new();

    private string _nome = string.Empty;
    private EspeciePet _especie = EspeciePet.Cao;
    private string? _raca;
    private PortePet _porte = PortePet.M;
    private TipoPelagemPet _pelagem = TipoPelagemPet.Curta;
    private TemperamentoPet _temperamento = TemperamentoPet.Docil;
    private decimal? _pesoKg;
    private int _tutorPrincipalId;
    private string? _microchip;
    private int? _convenioId;
    private string? _alergias;
    private SexoPet _sexo = SexoPet.Macho;
    private bool _castrado;
    private DateTime? _dataNascimento;
    private string? _corPelagem;

    private PetDto? _petEditando;
    private string _editNome = string.Empty;
    private string? _editRaca;
    private decimal? _editPesoKg;
    private PortePet _editPorte = PortePet.M;
    private SexoPet _editSexo = SexoPet.Macho;
    private bool _editCastrado;
    private DateTime? _editDataNasc;
    private string? _editCorPelagem;
    private TemperamentoPet _editTemp = TemperamentoPet.Docil;
    private string? _editAlergias;
    private bool _editObito;

    private PetDto? _petTutoresAlvo;
    private int _novoTutorClienteId;
    private TipoVinculoTutor _novoTutorVinculo = TipoVinculoTutor.Secundario;
    private bool _novoTutorPodeAssinar = true;

    protected override async Task OnInitializedAsync()
    {
        _clientes = await DbContext.Clientes.AsNoTracking().OrderBy(c => c.Nome).Take(200).ToListAsync();
        if (_clientes.Count > 0)
            _tutorPrincipalId = _clientes[0].Id;

        var convRes = await Mediator.Send(new GetConveniosPetQuery());
        if (convRes.Sucesso && convRes.Dados != null)
            _convenios = convRes.Dados;

        await CarregarPets();
    }

    private async Task CarregarPets()
    {
        _carregando = true;
        var res = await Mediator.Send(new GetPetsQuery(_busca));
        if (res.Sucesso && res.Dados != null)
            _pets = res.Dados;
        _carregando = false;
    }

    private async Task SalvarPet()
    {
        if (_tutorPrincipalId <= 0)
        {
            Snackbar.Add("Cadastre ou selecione um Tutor (Cliente) primeiro.", Severity.Warning);
            return;
        }

        var res = await Mediator.Send(new CreatePetCommand(
            _nome, _especie, _raca, _corPelagem, _sexo, _castrado, _dataNascimento, null,
            _porte, _pelagem, _pesoKg, _microchip, _temperamento, _alergias, null, null,
            _convenioId, null, _tutorPrincipalId));

        if (res.Sucesso)
        {
            Snackbar.Add("Pet cadastrado com sucesso!", Severity.Success);
            _nome = string.Empty;
            _raca = null;
            _exibirFormulario = false;
            await CarregarPets();
        }
        else
            Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private void AbrirEdicaoPet(PetDto pet)
    {
        _petEditando = pet;
        _editNome = pet.Nome;
        _editRaca = pet.Raca;
        _editPesoKg = pet.PesoAtualKg;
        _editPorte = pet.Porte;
        _editSexo = pet.Sexo;
        _editCastrado = pet.Castrado;
        _editDataNasc = pet.DataNascimento;
        _editCorPelagem = pet.CorPelagem;
        _editTemp = pet.Temperamento;
        _editAlergias = pet.Alergias;
        _editObito = pet.Obito;
    }

    private async Task SalvarEdicaoPet()
    {
        if (_petEditando == null) return;
        var res = await Mediator.Send(new UpdatePetCommand(
            _petEditando.Id, _editNome, _petEditando.Especie, _editRaca, _editCorPelagem,
            _editSexo, _editCastrado, _editDataNasc, _petEditando.IdadeEstimadaMeses,
            _editPorte, _petEditando.TipoPelagem, _editPesoKg, _petEditando.Microchip, _editTemp,
            _editAlergias, _petEditando.RestricoesAlimentares, _petEditando.Observacoes,
            _petEditando.ConvenioPetId, _petEditando.NumeroCarteirinhaConvenio,
            _editObito, _editObito ? DateTime.UtcNow : null, null));
        if (res.Sucesso)
        {
            Snackbar.Add("Pet atualizado!", Severity.Success);
            _petEditando = null;
            await CarregarPets();
        }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private void AbrirTutoresPet(PetDto pet)
    {
        _petTutoresAlvo = pet;
        if (_clientes.Count > 0) _novoTutorClienteId = _clientes[0].Id;
    }

    private async Task VincularTutor()
    {
        if (_petTutoresAlvo == null || _novoTutorClienteId <= 0) return;
        var res = await Mediator.Send(new VincularTutorPetCommand(_petTutoresAlvo.Id, _novoTutorClienteId, _novoTutorVinculo, _novoTutorPodeAssinar, true));
        if (res.Sucesso)
        {
            Snackbar.Add("Tutor vinculado!", Severity.Success);
            await CarregarPets();
            _petTutoresAlvo = _pets.FirstOrDefault(p => p.Id == _petTutoresAlvo.Id);
        }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }

    private async Task RemoverVinculoTutor(int tutorPetId)
    {
        var res = await Mediator.Send(new RemoverVinculoTutorPetCommand(tutorPetId));
        if (res.Sucesso)
        {
            Snackbar.Add("Vínculo removido!", Severity.Success);
            await CarregarPets();
            if (_petTutoresAlvo != null)
                _petTutoresAlvo = _pets.FirstOrDefault(p => p.Id == _petTutoresAlvo.Id);
        }
        else Snackbar.Add(string.Join(", ", res.Erros), Severity.Error);
    }
}
